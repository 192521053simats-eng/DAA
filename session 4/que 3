
def champagneTower(poured, query_row, query_glass):
    dp = [[0.0] * 101 for _ in range(101)]
    dp[0][0] = poured

    for i in range(100):
        for j in range(i + 1):
            if dp[i][j] > 1:
                excess = (dp[i][j] - 1) / 2
                dp[i+1][j] += excess
                dp[i+1][j+1] += excess

    return min(1.0, dp[query_row][query_glass])

poured = int(input())
query_row = int(input())
query_glass = int(input())

print(champagneTower(poured, query_row, query_glass))
