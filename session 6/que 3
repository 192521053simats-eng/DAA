def cross_product(p1, p2, p3):
    return ((p2[0] - p1[0]) * (p3[1] - p1[1]) -
            (p2[1] - p1[1]) * (p3[0] - p1[0]))


def convex_hull(points):
    hull = set()
    n = len(points)

    for i in range(n):
        for j in range(i + 1, n):
            left = False
            right = False

            for k in range(n):
                if k == i or k == j:
                    continue

                cross = cross_product(
                    points[i], points[j], points[k]
                )

                if cross > 0:
                    left = True
                elif cross < 0:
                    right = True

            if not (left and right):
                hull.add(points[i])
                hull.add(points[j])

    return list(hull)


points = [
    (10, 0), (11, 5), (5, 3), (9, 3.5),
    (15, 3), (12.5, 7), (6, 6.5), (7.5, 4.5)
]

print("Convex Hull:", convex_hull(points))
