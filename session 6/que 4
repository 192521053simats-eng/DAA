import math

def cross_product(p1, p2, p3):
    return ((p2[0] - p1[0]) * (p3[1] - p1[1]) -
            (p2[1] - p1[1]) * (p3[0] - p1[0]))


def convex_hull(points):
    hull = set()
    n = len(points)

    for i in range(n):
        for j in range(i + 1, n):
            left = False
            right = False

            for k in range(n):
                if k == i or k == j:
                    continue

                cross = cross_product(
                    points[i], points[j], points[k]
                )

                if cross > 0:
                    left = True
                elif cross < 0:
                    right = True

            if not (left and right):
                hull.add(points[i])
                hull.add(points[j])

    hull = list(hull)

    if len(hull) <= 2:
        return hull

    cx = sum(p[0] for p in hull) / len(hull)
    cy = sum(p[1] for p in hull) / len(hull)

    hull.sort(
        key=lambda p: math.atan2(p[1] - cy, p[0] - cx)
    )

    return hull


points = [(1, 1), (4, 6), (8, 1), (0, 0), (3, 3)]

print("Convex Hull:", convex_hull(points))
