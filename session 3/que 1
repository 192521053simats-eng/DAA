def paths(m,n,N,i,j):
    dp={(i,j):1}
    ans=0
    for _ in range(N):
        nd={}
        for (x,y),v in dp.items():
            for a,b in [(x+1,y),(x-1,y),(x,y+1),(x,y-1)]:
                if 0<=a<m and 0<=b<n:
                    nd[(a,b)]=nd.get((a,b),0)+v
                else: ans+=v
        dp=nd
    return ans

print(paths(2,2,2,0,0))
print(paths(1,3,3,0,1))
